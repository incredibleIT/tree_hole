# ============================================================
# RKOS 后端服务 - 开发环境变量配置
# ============================================================
# 用法：复制本文件为 .env，按需修改后执行 docker compose up
#   cp .env.example .env
#   docker compose up
# ============================================================

# ---------- 应用配置 ----------

# Spring Boot 应用对外端口（宿主机映射端口）
# 默认值：8080
SERVER_PORT=8080

# Spring 激活的 Profile
# 默认值：dev
SPRING_PROFILES_ACTIVE=dev

# RKOS API 密钥（开发用，生产环境必须更换）
# 默认值：dev-api-key-12345
RKOS_API_KEY=dev-api-key-12345

# ---------- MongoDB 配置 ----------

# MongoDB 主机地址（本地开发可留空，默认 localhost；Docker 模式下由 docker-compose 自动覆盖为服务名）
# 默认值：localhost
MONGO_HOST=localhost

# MongoDB 数据库名称
# 默认值：rkos_dev
MONGO_DB=rkos_dev

# MongoDB 宿主机映射端口
# 默认值：27017
MONGO_PORT=27017

# ---------- PostgreSQL 配置 ----------

# PostgreSQL 主机地址（本地开发可留空，默认 localhost；Docker 模式下由 docker-compose 自动覆盖为服务名）
# 默认值：localhost
POSTGRES_HOST=localhost

# PostgreSQL 数据库名称
# 默认值：rkos_dev
POSTGRES_DB=rkos_dev

# PostgreSQL 用户名
# 默认值：dev_user
POSTGRES_USER=dev_user

# PostgreSQL 密码（开发环境，生产环境必须更换）
# 默认值：dev_password
POSTGRES_PASSWORD=dev_password

# PostgreSQL 宿主机映射端口
# 默认值：5432
POSTGRES_PORT=5432
